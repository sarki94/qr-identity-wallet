{
  "name": "qrw-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline-first PWA: Verifier, Wallet, Issuer Portal and Auditor screens",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "phone": "vite build && vite preview --host --mode phone",
    "coverage": "vitest run --coverage --coverage.include=src/lib --coverage.reporter=text"
  },
  "dependencies": {
    "@noble/ed25519": "2.1.0",
    "@noble/hashes": "1.5.0",
    "pako": "2.1.0",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/pako": "2.0.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-basic-ssl": "1.1.0",
    "@vitejs/plugin-react": "4.3.3",
    "@vitest/coverage-v8": "2.1.4",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-pwa": "0.20.5",
    "vitest": "2.1.4"
  }
}
