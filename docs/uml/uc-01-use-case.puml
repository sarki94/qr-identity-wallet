@startuml UC
!include style.iuml
left to right direction

actor "Farmer\n(Holder)" as Farmer
actor "Enrolment\nOfficer" as Officer
actor "Redemption\nAgent" as Agent
actor "Programme\nAdmin" as Admin
actor "Auditor /\nM&E Officer" as Auditor
actor "NIMC\n<<external system>>" as NIMC

rectangle "QR Identity Wallet System" {
  usecase "UC-01 Enrol farmer" as UC01
  usecase "UC-02 Issue credential" as UC02
  usecase "UC-03 Bind wallet to credential" as UC03
  usecase "UC-04 Print paper wallet (L1)" as UC04
  usecase "UC-05 Revoke credential" as UC05
  usecase "UC-06 Manage wallet profiles" as UC06
  usecase "UC-07 Present credential" as UC07
  usecase "UC-08 Verify farmer offline" as UC08
  usecase "UC-09 Synchronise trust data" as UC09
  usecase "UC-10 Upload verification records" as UC10
  usecase "UC-11 Log in" as UC11
  usecase "UC-12 Manage staff and roles" as UC12
  usecase "UC-13 Review verification records" as UC13
  usecase "UC-14 View anomaly report" as UC14
}

Farmer -- UC03
Farmer -- UC06
Farmer -- UC07
Officer -- UC01
Officer -- UC02
Officer -- UC03
Officer -- UC04
Officer -- UC05
Officer -- UC11

UC01 -- NIMC
UC07 -- Agent
UC08 -- Agent
UC09 -- Agent
UC10 -- Agent
UC11 -- Agent
UC11 -- Admin
UC12 -- Admin
UC11 -- Auditor
UC13 -- Auditor
UC14 -- Auditor
@enduml
